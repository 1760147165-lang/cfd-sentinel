# Copy these names into your shell environment. Do not put real secrets here.
CFD_SENTINEL_SMTP_HOST=smtp.example.com
CFD_SENTINEL_SMTP_PORT=587
CFD_SENTINEL_SMTP_USERNAME=alert@example.com
CFD_SENTINEL_SMTP_PASSWORD=replace-with-an-app-password
CFD_SENTINEL_SMTP_FROM=alert@example.com
CFD_SENTINEL_SMTP_STARTTLS=true
